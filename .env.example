# Copy this file to .env.local for local development. Never commit real values.
# Vercel's VERCEL_URL and NODE_ENV are platform-managed; do not add them manually.

# Local prototype login only. Use a unique random value in each Vercel environment.
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes-in-hex

# Required when PostgreSQL/Prisma persistence is implemented before any Vercel deployment.
# Runtime URL should be the provider's pooled connection string; DIRECT_URL is for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
